---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import type { Category, Publisher } from '../types/game';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryOptions: Category[] = [];
const publisherOptions: Publisher[] = [];

for (const game of games) {
  if (game.category && !categoryOptions.some((category) => category.id === game.category?.id)) {
    categoryOptions.push(game.category);
  }
  if (game.publisher && !publisherOptions.some((publisher) => publisher.id === game.publisher?.id)) {
    publisherOptions.push(game.publisher);
  }
}

categoryOptions.sort((left, right) => left.name.localeCompare(right.name));
publisherOptions.sort((left, right) => left.name.localeCompare(right.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div
            class="mb-8 grid grid-cols-1 gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 md:grid-cols-[2fr_1fr_auto] md:items-end"
            data-testid="game-filters"
          >
            <fieldset>
              <legend class="mb-3 font-medium text-slate-100">Filter by category</legend>
              <div class="flex flex-wrap gap-3">
                {categoryOptions.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-slate-200 hover:bg-slate-700">
                    <input
                      type="checkbox"
                      value={category.id}
                      data-category-filter
                      data-testid={`category-filter-${category.id}`}
                      class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="publisher-filter" class="mb-3 block font-medium text-slate-100">
                Filter by publisher
              </label>
              <select
                id="publisher-filter"
                data-publisher-filter
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <option value="">All publishers</option>
                {publisherOptions.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <button
              type="button"
              data-testid="clear-filters"
              class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              Clear filters
            </button>
          </div>

          <p
            class="mb-4 text-sm text-slate-300"
            role="status"
            aria-live="polite"
            data-testid="filter-result-count"
          >
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>
          <p
            class="mb-4 rounded-lg border border-slate-700 bg-slate-800 p-4 text-slate-300"
            data-testid="no-filter-results"
            hidden
          >
            No games match the selected filters.
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterControls = document.querySelector<HTMLElement>('[data-testid="game-filters"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  if (filterControls && resultCount && noResults) {
    const categoryInputs = Array.from(
      filterControls.querySelectorAll<HTMLInputElement>('[data-category-filter]'),
    );
    const publisherSelect = filterControls.querySelector<HTMLSelectElement>('[data-publisher-filter]');
    const clearButton = filterControls.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    if (publisherSelect && clearButton) {
      const updateVisibleGames = (): void => {
        const selectedCategoryIds = categoryInputs
          .filter((input) => input.checked)
          .map((input) => input.value);
        const selectedPublisherId = publisherSelect.value;
        let visibleCount = 0;

        for (const card of gameCards) {
          const matchesCategory =
            selectedCategoryIds.length === 0 ||
            selectedCategoryIds.includes(card.dataset.categoryId ?? '');
          const matchesPublisher =
            selectedPublisherId === '' || card.dataset.publisherId === selectedPublisherId;
          const isVisible = matchesCategory && matchesPublisher;

          card.hidden = !isVisible;
          if (isVisible) visibleCount++;
        }

        resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
        noResults.hidden = visibleCount !== 0;
      };

      filterControls.addEventListener('change', updateVisibleGames);
      clearButton.addEventListener('click', () => {
        for (const input of categoryInputs) input.checked = false;
        publisherSelect.value = '';
        updateVisibleGames();
      });
      updateVisibleGames();
    }
  }
</script>
